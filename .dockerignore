.env.*
!.env.example

# ── IDE / 系统 ──
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ── Git / CI ──
.git/
.gitignore

# ── 测试与文档 ──
tests/
docs/
*.md

# ── Python 缓存 ──
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Docker 自身 ──
Dockerfile
.dockerignore
docker-compose*.yml