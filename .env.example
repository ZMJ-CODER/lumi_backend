# ==================== Lumi Backend 环境变量示例 ====================
# 复制为 .env 并填写真实值；不要把真实密钥提交到 git。

# ── 数据库 / Redis ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lumi_db
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# 至少一次投递；visibility timeout 必须大于硬超时。
CELERY_TASK_TIME_LIMIT_SECONDS=1800
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=1500
CELERY_REDIS_VISIBILITY_TIMEOUT_SECONDS=2700
CELERY_DOCUMENT_STALE_AFTER_SECONDS=3000

# ── LLM：默认 DeepSeek V4 Flash；另可在模型选择器切到 Qwen Turbo / V4 Pro ──
# 自定义 BYOK 端点默认只能使用公网地址。仅桌面或受信任自托管部署需要
# 访问 localhost/内网 Ollama、LM Studio 时才设为 true（云端请保持 false）。
BYOK_ALLOW_PRIVATE_BASE_URL=false
LLM_PROVIDER=deepseek
# 主供应商调用失败（连接/超时/5xx/空内容）时自动切换的备用供应商；空则不降级
LLM_FALLBACK_PROVIDER=
# 后端进程使用的显式 HTTP(S) 代理；为空时依次读取 HTTP_PROXY/HTTPS_PROXY
# 与 Windows 系统代理。宿主机本地运行可填 http://127.0.0.1:7890；Docker 容器
# 应填 http://host.docker.internal:7890，并在代理软件中开启 LAN 访问。
LLM_HTTP_PROXY=
# 默认为空：官方 DeepSeek V4 自动按接口契约发送推理参数；其他兼容端点只有在
# 已验证支持 reasoning_effort 时才填写模型 ID，多个以逗号分隔。
LLM_REASONING_EFFORT_MODELS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

# ── 模型档位（Model Profile）：业务只认"角色"，不认模型名 ──
# 四个档位：main（默认主模型）/ cheap（分类·摘要·标题·改写等低成本中间任务）/
# reasoning（复杂规划·代码分析·动态 Agent）/ vision（图片·扫描件·PPT 视觉理解）。
# 留空 = 按档位语义继承：main→上面的旧全局配置；cheap→DS_FLASH_MODEL/QWEN_TURBO_MODEL；
# reasoning→CHAT_THINK_MODEL；vision→VL_MODEL。
# 也可以不改 .env，直接在后台「模型档位」页改（写 Redis，立即生效、无需重启）。
LLM_MAIN_PROVIDER=
LLM_MAIN_BASE_URL=
LLM_MAIN_API_KEY=
LLM_MAIN_MODEL=

LLM_CHEAP_PROVIDER=
LLM_CHEAP_BASE_URL=
LLM_CHEAP_API_KEY=
LLM_CHEAP_MODEL=

LLM_REASONING_PROVIDER=
LLM_REASONING_BASE_URL=
LLM_REASONING_API_KEY=
LLM_REASONING_MODEL=

LLM_VISION_PROVIDER=
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=

# 档位能力覆盖（留空用内置默认声明）：未知能力会被安全兜底
# LLM_CHEAP_SUPPORTS_TOOLS=false
# LLM_MAIN_SUPPORTS_VISION=false
# LLM_REASONING_MAX_CONTEXT=128000

# ── 职责 → 档位（Model Role）：留空用 app/core/model_roles.py 的默认表 ──
# 默认：标题/摘要/意图评估/查询改写/记忆抽取=cheap；最终回答/写代码=main；
# 执行/代码审查=reasoning；视觉=vision。
# 想"先完全不改行为"：把这些全部设为 main 即可。
# LLM_ROLE_TITLE=cheap
# LLM_ROLE_SUMMARY=cheap
# LLM_ROLE_INTENT_ASSESSOR=cheap
# LLM_ROLE_QUERY_REWRITER=cheap
# LLM_ROLE_MEMORY_EXTRACT=cheap
# LLM_ROLE_MEMORY_MERGE=cheap
# LLM_ROLE_PLANNER_SIMPLE=cheap
# LLM_ROLE_PLANNER_COMPLEX=main
# LLM_ROLE_TOOL_READ=cheap
# LLM_ROLE_TOOL_WRITE=main
# LLM_ROLE_TOOL_EXECUTE=reasoning
# LLM_ROLE_DIRECT_ANSWER=main
# LLM_ROLE_FINAL_SUMMARY=main
# LLM_ROLE_CODE_WRITER=main
# LLM_ROLE_CODE_REVIEWER=reasoning
# LLM_ROLE_VISION=vision

# ── 嵌入模型（bge-m3, 1024 维） ──
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_CACHE_DIR=data/models
EMBEDDING_DEVICE=cpu

# ── RAG ──
# 本地只有 qwen2.5vl 等视觉模型时不要启用 local；使用千问文本模型改写。
RAG_QUERY_REWRITE_PROVIDER=cloud
RAG_QUERY_REWRITE_MODEL=
RAG_QUERY_REWRITE_BASE_URL=http://localhost:11434/v1
RAG_TOP_K=5
# 与 app/core/config.py 默认值一致；生产值必须由 scripts/evaluate_rag.py 的标注集确定。
RAG_SIMILARITY_THRESHOLD=0.5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ── 联网搜索（Tavily） ──
TAVILY_API_KEY=

# ── 长期记忆加密 ──
# base64 32 字节主密钥（openssl rand -base64 32 生成）；泄露时轮换并升级 key_version
MEMORY_ENCRYPTION_KEY=
MEMORY_ENCRYPTION_KEY_VERSION=1
MEMORY_EXTRACTION_MODEL=qwen-turbo
MEMORY_FACT_MIN_VECTOR_SIMILARITY=0.75
# 记忆默认纯向量检索；只有评测证明必要时才开启关键词兜底。
MEMORY_FACT_KEYWORD_FALLBACK_ENABLED=false

# ── 安全 ──
# 随机 JWT 密钥（openssl rand -base64 48 / secrets.token_urlsafe(48)）
JWT_SECRET_KEY=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── 安全：全局限流（Redis，按 IP） ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
# 精细令牌桶：登录用户按 user_id（游客按 IP）分别计数；每个 SSE 请求只扣一次。
RATE_LIMIT_USER_ENABLED=true
RATE_LIMIT_CHAT_STREAM_CAPACITY=12
RATE_LIMIT_CHAT_STREAM_REFILL_PER_MINUTE=12
RATE_LIMIT_OFFICE_SUBMIT_CAPACITY=4
RATE_LIMIT_OFFICE_SUBMIT_REFILL_PER_MINUTE=2
RATE_LIMIT_UPLOAD_CAPACITY=10
RATE_LIMIT_UPLOAD_REFILL_PER_MINUTE=10

# ── 外部依赖熔断（LLM / Tavily / MCP）──
# 仅网络、超时、429、5xx 会计入失败；401/402/模型名错误会直接反馈给用户。
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30
CIRCUIT_BREAKER_HALF_OPEN_PROBE_SECONDS=15

# ── 可观测性 ──
# 错误上报：留空则不启用（生产建议配置 Sentry DSN）
SENTRY_DSN=
# Prometheus 指标开关（/metrics）
METRICS_ENABLED=true
# 高频只读 API 响应缓存（Redis，按用户隔离；Redis 故障自动回退数据库）
READ_VIEW_CACHE_ENABLED=true
READ_VIEW_USER_TTL_SECONDS=5
READ_VIEW_CONVERSATIONS_TTL_SECONDS=10
READ_VIEW_MEMORY_TTL_SECONDS=15
# Docker secret 注入目录（容器内默认 /run/secrets；本地开发无需配置）
SECRETS_DIR=/run/secrets

# ── 语音 / TTS ──
WHISPER_MODEL=base
TTS_PROVIDER=local_qwen3
TTS_MODEL=cosyvoice-v1

# ── Hugging Face 模型下载 ──
# RAG embedding / reranker / Docling 模型的国内下载源。已下载的
# data/models 本地模型优先使用，不会因重建镜像再次下载。
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1

# ── MCP ──
# 多用户桌面端不使用固定地址的 MCP 直连；桌面类 Skill 由当前登录用户的专属请求队列执行。
# 如需接入独立、受信的服务端 MCP，可在此配置；不得配置用户桌面端地址。
MCP_SERVERS=[]
# 本地 Electron 原子 Tool Provider 示例：
# MCP_SERVERS=[{"name":"lumi_client","provider_type":"desktop_mcp","transport":"streamable-http","url":"http://127.0.0.1:8765/mcp"}]

# ── Python 脚本隔离沙箱 ──
# 生产必须使用 Docker 沙箱。构建一次性脚本镜像后再启动 API：
#   docker compose --profile sandbox build sandbox-image
# Docker 不可用时 python_exec 会被隐藏，不会回退为后端本地执行。
AGENT_SANDBOX_TYPE=docker
AGENT_ALLOW_UNSAFE_LOCAL_SANDBOX=false
AGENT_SANDBOX_DOCKER_IMAGE=lumi-python-sandbox:latest
AGENT_SANDBOX_TIMEOUT_SECONDS=30
AGENT_SANDBOX_MAX_ARTIFACT_FILES=128
AGENT_SANDBOX_MAX_ARTIFACT_BYTES=33554432
AGENT_SANDBOX_DOCKER_MEMORY=512m
AGENT_SANDBOX_DOCKER_CPUS=0.5
AGENT_SANDBOX_DOCKER_PIDS_LIMIT=64
# Linux Docker socket 所属组 GID（部署前：stat -c '%g' /var/run/docker.sock）。
# Docker Desktop 常见为 0；不匹配时脚本能力会安全隐藏。
DOCKER_GID=0

# 办公任务性能上限：规划走一次兼容 JSON 调用，不先探测 response_format/json_schema。
AGENT_NODE_MAX_RETRIES=1
AGENT_NODE_TIMEOUT_SECONDS=120
# 0 表示使用全局超时；可按路由通道或单个工具配置硬超时。
AGENT_NODE_TIMEOUT_DIRECT_LLM_SECONDS=0
AGENT_NODE_TIMEOUT_SCRIPT_SECONDS=0
AGENT_NODE_TIMEOUT_RAG_SECONDS=0
AGENT_NODE_TIMEOUT_AGENT_SECONDS=0
AGENT_NODE_TOOL_TIMEOUTS_JSON={}
# 写操作不能在 Redis 协调失效时退化为本进程锁；只读节点仍可继续执行。
AGENT_WRITE_RESOURCE_FAIL_CLOSED=true
# 写资源协调不可用时的最大自动等待时长；到期转为 paused，且等待任务不占活动配额。
AGENT_WAITING_RESOURCES_TIMEOUT_SECONDS=1800
# PostgreSQL effect journal: stale intent-only records are marked uncertain
# during startup recovery and are never automatically retried.
AGENT_EFFECT_INTENT_RECOVERY_GRACE_SECONDS=900
# 高风险审批无人处理时自动失败，防止任务无限占用准入容量。
AGENT_APPROVAL_TIMEOUT_SECONDS=86400
# 分支/逻辑计划依赖的结果引用至少保留 7 天，独立于任务快照（默认 24 小时）。
AGENT_RESULT_REF_TTL_SECONDS=604800
AGENT_PLANNER_MAX_TOKENS=2048
AGENT_PLANNER_TIMEOUT_SECONDS=45
AGENT_FINAL_ANSWER_MAX_TOKENS=2500
AGENT_MANIFEST_SUMMARY_MAX_TOKENS=1200
# 四通道路由：单清单请求超过预算会要求确认/拆分；复杂 Agent 与沙箱独立限流
AGENT_MANIFEST_TOKEN_BUDGET=80000
# 普通 DAG 的执行前编译窗口上限；超出后使用逻辑计划滚动物化，不静默截断
AGENT_PLAN_MAX_NODES=6
# L3 动态子图：节点只能上报升级协议，由持久化 DAG 编排器校验并挂载替代子图。
AGENT_DYNAMIC_SUBGRAPH_ENABLED=true
AGENT_SUBGRAPH_MAX_REPLANS=2
AGENT_CHANNEL_DIRECT_LLM_CONCURRENCY=32
AGENT_CHANNEL_SCRIPT_CONCURRENCY=20
AGENT_CHANNEL_RAG_CONCURRENCY=12
AGENT_CHANNEL_AGENT_CONCURRENCY=2

# ── 办公任务背压（跨 worker 的 Redis 准入槽）──
# 达到容量立即返回 429，不在 API 进程内堆积请求。
AGENT_GLOBAL_ACTIVE_JOB_LIMIT=32
AGENT_USER_ACTIVE_JOB_LIMIT=2
AGENT_SUBMISSION_MAX_INFLIGHT=8
# 当前默认 legacy。temporal 将已审核的静态 DAG 交给独立 Worker；
# manifest_temporal 仅用于已授权的滚动任务清单。
AGENT_ORCHESTRATION=legacy
# 仅限制静态、完全物化、无副作用 DAG 的 Temporal 运行时；不改变普通 DAG 窗口。
TEMPORAL_STATIC_MAX_NODES=12
# 超过普通静态窗口的纯读 DAG 专用限制；审批、写操作和动态 Agent 不会进入该路径。
# 长 DAG 尚需 Temporal 服务级演练；默认关闭，验证后再显式开启。
TEMPORAL_STATIC_LONG_DAG_ENABLED=false
TEMPORAL_STATIC_LONG_DAG_MAX_NODES=64
TEMPORAL_STATIC_CONTINUE_AS_NEW_AFTER_NODES=20
TEMPORAL_STATIC_CHILD_WORKFLOW_ENABLED=true
# Temporal 静态任务灰度。白名单非空时仅该用户进入；类型填写 agent 或通道名。
# temporal 模式默认 100；上线建议先设 5，并配合白名单观察。
TEMPORAL_STATIC_ALLOWLIST=
TEMPORAL_STATIC_PERCENTAGE=100
TEMPORAL_STATIC_TASK_TYPES=
# 静态纯读任务最多一次 Activity 重规划；写、审批和动态 Agent 不走此路径。
TEMPORAL_STATIC_MAX_REPLANS=1
# Redis 完整逻辑计划的纯读前沿 Runtime。默认关闭；验收时先配白名单和小比例，
# 不迁移 ReAct、审批、写操作或自动 LLM 重规划。
TEMPORAL_LOGICAL_READ_ENABLED=false
TEMPORAL_LOGICAL_READ_ALLOWLIST=
TEMPORAL_LOGICAL_READ_PERCENTAGE=0
TEMPORAL_LOGICAL_READ_TASK_TYPES=
TEMPORAL_LOGICAL_READ_TASK_QUEUE=lumi-logical-read
TEMPORAL_LOGICAL_READ_CONTINUE_AFTER_FRONTIERS=20
TEMPORAL_LOGICAL_READ_MAX_REPLANS=1
# 仅预声明审批+幂等键的逻辑计划副作用节点；不支持 ReAct 或自动重规划。
TEMPORAL_LOGICAL_EFFECTS_ENABLED=false
TEMPORAL_LOGICAL_EFFECTS_ALLOWLIST=
TEMPORAL_LOGICAL_EFFECTS_PERCENTAGE=0
TEMPORAL_LOGICAL_EFFECTS_TASK_TYPES=
TEMPORAL_LOGICAL_EFFECTS_TASK_QUEUE=lumi-logical-effects
TEMPORAL_LOGICAL_EFFECTS_CONTINUE_AFTER_FRONTIERS=20
# 路由策略 v1 先只影子求值；切换 enforce 前必须通过回归集与灰度指标。
AGENT_ROUTING_POLICY_MODE=shadow
AGENT_ROUTING_POLICY_PATH=config/agent_policies/routing_rules.yaml
# TCA v1 accepts only numeric scoring weights/thresholds, loaded at startup.
AGENT_TCA_POLICY_PATH=config/agent_policies/tca_rules.yaml
AGENT_ROUTING_LEXICON_PATH=config/agent_policies/routing_lexicon.yaml
AGENT_EXECUTION_DEFAULTS_PATH=config/agent_policies/execution_defaults.yaml
MCP_CLIENT_APPROVAL_WAIT_S=600
AGENT_ROUTING_INTENT_PATTERN_PATH=config/agent_policies/route_intent_patterns.yaml
AGENT_PLANNING_POLICY_PATH=config/agent_policies/planning_rules.yaml
TEMPORAL_MANIFEST_TASK_QUEUE=lumi-office-manifest
TEMPORAL_MANIFEST_CONTINUE_AS_NEW_BATCHES=40
TEMPORAL_ACTIVITY_HEARTBEAT_SECONDS=15
AGENT_ADMISSION_LEASE_SECONDS=7200

# ── 办公文档临时会话 TTL（小时，前端另有轮次上限） ──
OFFICE_SESSION_TTL_HOURS=24

# ── 产物下载短链 TTL（秒） ──
# artifact_created 事件只给 artifact_id；前端点击卡片时调 download-url 换短时 URL，
# 服务端重新校验归属后签发。过期是正常路径（前端只重取一次），上限 3600 由代码夹取。
ARTIFACT_DOWNLOAD_URL_TTL_SECONDS=300
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_TOP_K=20
RAG_RERANK_FINAL_K=5
RAG_RERANK_DEVICE=cpu
# 思考档/办公检索：原 query + 一条受控扩写双路召回；快速档不调用改写模型。
RAG_QUERY_REWRITE_MAX_VARIANTS=2
RAG_SPARSE_EXPERIMENT_ENABLED=false
RAG_SPARSE_MODEL=BAAI/bge-m3
RAG_SPARSE_DEVICE=cpu

# ── 《事件协议整合版》接入灰度开关（默认全关；先影子运行比对再切主链路）──
CAPABILITY_PREFLIGHT_V2=false
MODEL_CAPABILITY_ROUTER_V2=false
EFFECT_JOURNAL_RECOVERY_V2=false
TASK_PROFILE_CANONICAL=false
PLUGIN_QUOTA_ENFORCEMENT=false
ARCHIVE_CONTENT_V2=false
INTEGRATION_SHADOW_MODE=false

# ── 《任务理解、路由与能力预检》接入开关（默认全关；关掉即回到旧路径）──
# TASK_PROFILE_CANONICAL：用 canonical 画像的动作意图/目标范围/清晰度驱动路由硬约束
#   （intents 非空禁直聊/单读；DELETE/EXECUTE/PUBLISH 强制审批；目标未知走澄清）。
# CAPABILITY_PREFLIGHT_V2：统一 CapabilityPreflightService 接管预检（失败不调模型、不给空工具集）。
# INTEGRATION_SHADOW_MODE：新旧判定并行记录差异（影子期不切换路由），用于"达标才切换"。
TASK_PROFILE_CANONICAL=false
CAPABILITY_PREFLIGHT_V2=false
INTEGRATION_SHADOW_MODE=false

# ── 过程日志归档保留策略（阶段 3；按归档类别，代码不写死）──
# 类别 → 保留类别（retention class）→ 清理器：
#   LOG_ARCHIVE_RETENTION_ACTIVE_TASK_SECONDS      → EPHEMERAL_ARCHIVE（短期，归档清理器）
#   LOG_ARCHIVE_RETENTION_COMPLETED_JOB_SECONDS    → AUDIT_ARCHIVE（中期，归档清理器）
#   LOG_ARCHIVE_RETENTION_USER_ARTIFACT_SECONDS    → USER_ARTIFACT（工作区策略，用户产物清理器）
# 归档不再与 office_outputs 共用一条 7 天兜底规则（GENERATED_FILES_TTL_DAYS）；
# 请求值超过天花板时按 min 生效，且夹取原因会写进产物 ref 与 GET /api/v1/artifacts/{id}。
LOG_ARCHIVE_RETENTION_ACTIVE_TASK_SECONDS=86400
LOG_ARCHIVE_RETENTION_COMPLETED_JOB_SECONDS=604800
LOG_ARCHIVE_RETENTION_USER_ARTIFACT_SECONDS=2592000

# ── Job 运行视图快照写入契约（**这不是开关**）──
# FLAG DOES NOT CONTROL SNAPSHOT WRITES
# 运行视图快照（multiagent:job_snapshot:{job_id}）是任务恢复与前端刷新的基础设施，
# **始终写入**：唯一写路径是 app/services/job_snapshot_store.py::SnapshotWriter →
# JobRunView.to_snapshot()（含体积收缩），写入方为 RedisStateStore.create_job/save_job，
# 失败只记日志、不影响任务状态。写入会记录 TTL、SNAPSHOT_WRITER_VERSION 与指标
# lumi_job_snapshot_writes_total。
# 灰度开关（ARCHIVE_CONTENT_V2 等）只影响"快照里放什么"（是否带过程日志归档引用），
# 不影响"快照是否落库"；读取路径（read_snapshot/get_run_view）同样不受开关控制。
# 快照 TTL = AGENT_JOBS_TTL_SECONDS。
AGENT_JOBS_TTL_SECONDS=86400

# ── 《结果存储、检查点与恢复》接入开关（默认全关；关掉即回到旧路径）──
# RESULT_STORE_V2：Tool/Skill/MCP 结果统一进 ResultStore（分层 + sha256 + schema_version
#   + 过期 + 按预算加载），Job 快照只留摘要与最小引用（{id, sha256}）。
# STEP_CHECKPOINT_V2：每步写检查点（planned→started→running→waiting_approval→
#   completed|failed|cancelled|uncertain），并保证**完成事件在检查点落盘之后**。
# EFFECT_JOURNAL_TYPED_V2：副作用日志额外记录 effect_type / effect_key，支持 pending 在途核对。
RESULT_STORE_V2=false
STEP_CHECKPOINT_V2=false
EFFECT_JOURNAL_TYPED_V2=false

# ── 运行时策略热更新（Redis Key + TTL + 本地轮询；不引入配置中心）──
# RUNTIME_POLICY_OVERRIDE：打开后 Worker 每 POLICY_POLL_INTERVAL_SECONDS 秒查一次
# ``policy:epoch``，变了才全量拉取 ``policy:<epoch>``（Hash：field=provider:xxx/model:xxx，
# value=JSON）。关闭时零开销直通，调用点只认代码与 .env 默认值。
# 管理入口：PUT /api/v1/admin/policies（只需 superadmin JWT；二次密码验证已于 2026-09 移除）。
RUNTIME_POLICY_OVERRIDE=false
# POLICY_POLL_INTERVAL_SECONDS：轮询间隔 = 策略最坏生效延迟（默认 10s）。
POLICY_POLL_INTERVAL_SECONDS=10
# POLICY_CACHE_MAX_TTL_SECONDS：本地缓存可信上限。Redis 挂掉后超过它必须退回代码默认值，
# 不允许无限期沿用旧策略（Fail-Open 要有边界）。
POLICY_CACHE_MAX_TTL_SECONDS=600
# POLICY_BUCKET_TTL_SECONDS：epoch 桶自身的 TTL（旧桶没人读也要自己过期，
# 否则运维面板改久了会把 Redis 写满）。
POLICY_BUCKET_TTL_SECONDS=86400
# 代码默认值（第三层兜底的终点；运行时策略缺字段时用它们）。
POLICY_DEFAULT_TIMEOUT_SECONDS=30
POLICY_DEFAULT_MAX_CONCURRENT=4

# ── 统一绝对截止时间（contextvars 传播，不逐层传参）──
# REQUEST_DEADLINE_SECONDS：一次请求/任务的总预算。入口设一次，
# LLM/MCP/工具/沙箱等深层调用只读"剩余预算"，函数签名不变。
REQUEST_DEADLINE_SECONDS=300
# 剩余预算低于该值即拒绝发起新的外部调用（留给收尾与落盘）。
REQUEST_DEADLINE_MIN_BUDGET_SECONDS=1
# JOB_DEADLINE_SECONDS：**后台 Job** 每一段执行的预算（秒）。后台任务与请求预算
# **解耦**：装上任务自己的绝对截止时间并脱离请求作用域（不是取 min），否则
# ①SSE 断开后请求预算只剩几秒会把长任务掐死；②没有请求上下文时任务完全没有上限，
# 一个卡住的 Provider 调用能永久占住 worker。0 = 关闭（不限制，也仍然不继承请求预算）。
JOB_DEADLINE_SECONDS=1800
# 任务预算耗尽时的收尾余量（秒）：任务要落库/发事件/写结果，与请求侧分开配置。
JOB_DEADLINE_MIN_BUDGET_SECONDS=1

# ── 写操作代际校验（Redis Fail-Open 的**写侧** Fail-Closed）──
# WRITE_GATE_ENFORCEMENT：打开后写类操作必须持有"未过期且代际一致"的写租约；
# 本地无缓存 / 租约过期 / 代际不一致 / Redis 报错 → 一律阻断写。
# 读路径仍然是 Fail-Open（Redis 抖一下不该让服务不可用）。
WRITE_GATE_ENFORCEMENT=false
WRITE_GATE_LEASE_TTL_SECONDS=120
WRITE_GATE_REDIS_TTL_SECONDS=600

# ── 统一工具注册表（方案《工具发现链路》P1）──
# TOOL_REGISTRY_DERIVED：打开后"工具→能力 / 能力→MCP 目标 / 动作意图→工具窗口 /
# 审批策略 / Provider 路由 / 执行环境 / 可见场景"都从统一 Tool Registry 派生，
# 静态表退化为兜底。关闭（默认）时静态表仍是唯一真相源，行为逐字不变。
# 切换前先看影子差异：GET /api/v1/admin/policies/tools 的 switch_safe 必须为 true。
TOOL_REGISTRY_DERIVED=false
# TOOL_REGISTRY_SHADOW_LOG：每次任务提交打点一次"静态 vs 派生"差异（只记录，不改行为）。
TOOL_REGISTRY_SHADOW_LOG=true

# ── 统一资源能力层（方案《资源能力层》Phase 2）──
# RESOURCE_CAPABILITY_WINDOW：打开后工具窗口由"动作意图 + 资源类型 → 统一能力 →
# 候选 Provider"派生，旧 ACTION_TOOL_WINDOW 降级为 fallback；同时启用"变更类工具必须
# 带上同资源读取入口"的截断保护（核心读取能力不被 Top-K 挤掉）。
# **关闭（默认）时旧路径逐字不变**；打开后窗口只多不少（多出读取入口与同资源的
# 其他 Provider 工具）——开之前先看 GET /api/v1/admin/policies/tools 的
# `intent→resource_window(resource layer)` 披露栏（那是"打开后会多出什么"的预览）。
RESOURCE_CAPABILITY_WINDOW=false
# RESOURCE_CAPABILITY_DISPATCH：派发前解析**结构化目标**（能力 / 资源类型 / Provider
# Adapter），不再从工具名"猜"能力；Broker 按资源类型收窄 Provider 候选（收窄后没有候选
# 时按收窄前继续——声明缺失不该表现成"工具不可用"）。写操作仍然走租约/审批/版本校验/写闸。
# 关闭（默认）时旧解析逐字不变（旧 MCP 名兼容解析保留一个版本周期）。
RESOURCE_CAPABILITY_DISPATCH=false
# RESOURCE_CAPABILITY_WORKFLOW：Workflow Skill 按**能力声明**选择与校验工具
# （required_capabilities / resource_types / providers），底层 MCP 名字退化为兼容层
# （依赖只补不替：能力派生的依赖行是补充，不会让旧依赖检查变松）。
# 关闭（默认）时逐字走旧的 allowed_tools 白名单。
RESOURCE_CAPABILITY_WORKFLOW=false
# RESOURCE_CAPABILITY_SURFACE：模型可见工具面收敛到 Read / Write / Edit / Move / Delete /
# Run / Search（实现层名字如 workspace_write / mcp__… / office_doc_edit 不再直接暴露，
# 执行时按能力+资源类型经 Provider Adapter 解析；解析不出报 MODEL_ALIAS_UNAVAILABLE）。
# **分类不了的工具一律保留原名**（本机动作、编排原语、外部服务、以及刻意不收敛的
# artifact.create）——"不认识"绝不等于"可以拿走"。
# 关闭（默认）时注入路径逐字不变；切换前先看 GET /api/v1/admin/policies/tools 的
# `tool→model_surface(converged)` 披露栏与 `resource_surface.hidden_tools`。
# 已接入三条模型注入路径：chat_graph、react_runner、Workflow（schema + SOP 运行期翻译）。
# 七个动词表达不了的阶段/辅助动作（暂存/提交/回滚/diff/沙箱准备）**保留原名**。
RESOURCE_CAPABILITY_SURFACE=false
# 注：过程日志与 SSE 步骤帧里的**结构化能力标签**（capability / resource_type /
# provider_id / provider_name / display_name）**没有开关**——它们是目录事实，开关关闭时
# 也照常下发（`display_name` 此时等于工具名，故省略不下发）。前端可以据此显示"写入工作区"
# 而不必自己维护工具名映射。标签走闭集形状闸门（^[A-Za-z0-9_.:@-]{1,80}$），
# 参数/路径/正文不可能借道；字段可选 + exclude_none ⇒ 老载荷逐字不变。

# ── 统一结果存储（ResultStore 分层；阈值按**序列化字节数**判定，代码里不写死）──
# ≤ REDIS 进 Redis（短摘要/错误码）；≤ LOCAL 进本地受控目录（中等结果）；
# 更大的落 Blob（长正文/大日志/PPT 正文/生成文件）。
# 业务层只使用 result_ref，不感知后端；引用带 sha256 + schema_version + expires_at，
# 过期返回 RESULT_REF_EXPIRED（绝不静默当空结果），hash 不符直接拒绝交付。
RESULT_STORE_REDIS_MAX_BYTES=65536
RESULT_STORE_LOCAL_MAX_BYTES=4194304
# Blob 后端：local（默认，本地受控目录，无需新依赖）/ s3（MinIO / OSS / S3 兼容，需要 boto3）。
RESULT_STORE_BLOB_BACKEND=local
RESULT_STORE_BLOB_BUCKET=lumi-results
RESULT_STORE_BLOB_PREFIX=agent-results
RESULT_STORE_BLOB_ENDPOINT=
RESULT_STORE_BLOB_REGION=
RESULT_STORE_BLOB_ACCESS_KEY=
RESULT_STORE_BLOB_SECRET_KEY=
RESULT_STORE_BLOB_USE_SSL=true
# Blob 不可用时是否回退本地目录（本地开发 true；生产可设 false 以 fail-closed）。
RESULT_STORE_BLOB_FALLBACK_LOCAL=true
# 结果引用保留期：0 = 跟随 AGENT_RESULT_REF_TTL_SECONDS。
RESULT_STORE_TTL_SECONDS=0
# 单次按需加载的默认字符预算（注入下游上下文前按预算截断）。
RESULT_STORE_LOAD_MAX_CHARS=24000

# ── job_runs / job_steps 异步数据库投影（默认关闭）──
# 事实源是 Redis Job State + ResultStore + Effect Journal；DB 只是查询/审计投影：
# 批量幂等 upsert，DB 写失败不阻塞任务执行，恢复后可补写。
# 迁移：alembic/versions/0015_result_checkpoint_projection.py。
JOB_PROJECTION_ENABLED=false

