# ==================== Lumi Backend 环境变量示例 ====================
# 复制为 .env 并填写真实值；不要把真实密钥提交到 git。

# ── 数据库 / Redis ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lumi_db
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── LLM：DeepSeek / Qwen（按 LLM_PROVIDER 选择默认） ──
LLM_PROVIDER=deepseek
# 主供应商调用失败（连接/超时/5xx/空内容）时自动切换的备用供应商；空则不降级
LLM_FALLBACK_PROVIDER=qwen
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ── 嵌入模型（bge-m3, 1024 维） ──
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_CACHE_DIR=data/models
EMBEDDING_DEVICE=cpu

# ── RAG ──
RAG_QUERY_REWRITE_PROVIDER=local
RAG_QUERY_REWRITE_MODEL=qwen2.5:3b
RAG_QUERY_REWRITE_BASE_URL=http://localhost:11434/v1
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ── 联网搜索（Tavily） ──
TAVILY_API_KEY=

# ── 长期记忆加密 ──
# base64 32 字节主密钥（openssl rand -base64 32 生成）；泄露时轮换并升级 key_version
MEMORY_ENCRYPTION_KEY=
MEMORY_ENCRYPTION_KEY_VERSION=1
MEMORY_EXTRACTION_MODEL=qwen-turbo

# ── 安全 ──
# 随机 JWT 密钥（openssl rand -base64 48 / secrets.token_urlsafe(48)）
JWT_SECRET_KEY=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── 安全：全局限流（Redis，按 IP） ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20

# ── 可观测性 ──
# 错误上报：留空则不启用（生产建议配置 Sentry DSN）
SENTRY_DSN=
# Prometheus 指标开关（/metrics）
METRICS_ENABLED=true
# Docker secret 注入目录（容器内默认 /run/secrets；本地开发无需配置）
SECRETS_DIR=/run/secrets

# ── 语音 / TTS ──
WHISPER_MODEL=base
TTS_PROVIDER=local_qwen3
TTS_MODEL=cosyvoice-v1

# ── MCP 混合架构：客户端技能直连 Electron 端 MCP server（可插拔） ──
MCP_SERVERS=[{"name":"lumi_client","transport":"streamable-http","url":"http://127.0.0.1:8765/mcp"}]

# ── 办公文档临时会话 TTL（小时，前端另有轮次上限） ──
OFFICE_SESSION_TTL_HOURS=24
